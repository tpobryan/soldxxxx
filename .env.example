# Generate a strong random value for this (e.g. python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=change-this-to-a-random-secret

# Server
HOST=0.0.0.0
PORT=5002

# Auth — leave APP_LOGIN_PASSWORD empty to disable authentication entirely
APP_LOGIN_USERNAME=admin
APP_LOGIN_PASSWORD=
